# ─── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sms_db?schema=public"

# ─── Optional (Uploads) ────────────────────────────────────────────────────────
# Max file size in bytes (default: 10 MB)
MAX_FILE_SIZE=10485760
